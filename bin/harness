#!/usr/bin/env bash
# harness — versioning + sync helper for the Claude Code harness template.
#
# Single dispatcher with subcommands. The pure helper functions below are
# sourceable (see the guard at the bottom) so tests/test.sh can unit-test them
# without invoking `main`.
#
# Portability: targets macOS system bash 3.2 + BSD tools. No associative
# arrays, no ${var^^}, no mapfile, no `sort -V`, no GNU-only `sed -i`.

# --- pure helpers (unit-tested via tests/test.sh) --------------------------

# semver_cmp A B -> prints -1 (A<B), 0 (A==B), 1 (A>B).
# Splits on '.' and compares each field numerically (no `sort -V`, which BSD
# sort lacks).
semver_cmp() {
  local a1 a2 a3 b1 b2 b3
  IFS=. read -r a1 a2 a3 <<EOF
$1
EOF
  IFS=. read -r b1 b2 b3 <<EOF
$2
EOF
  if [ "$a1" -ne "$b1" ]; then
    [ "$a1" -lt "$b1" ] && printf '%s\n' -1 || printf '%s\n' 1
    return 0
  fi
  if [ "$a2" -ne "$b2" ]; then
    [ "$a2" -lt "$b2" ] && printf '%s\n' -1 || printf '%s\n' 1
    return 0
  fi
  if [ "$a3" -ne "$b3" ]; then
    [ "$a3" -lt "$b3" ] && printf '%s\n' -1 || printf '%s\n' 1
    return 0
  fi
  printf '%s\n' 0
}

# semver_bump VERSION LEVEL -> prints the bumped version.
#   major: X+1.0.0   minor: X.Y+1.0   patch: X.Y.Z+1
semver_bump() {
  local x y z
  IFS=. read -r x y z <<EOF
$1
EOF
  case "$2" in
    major) printf '%s\n' "$((x + 1)).0.0" ;;
    minor) printf '%s\n' "$x.$((y + 1)).0" ;;
    patch) printf '%s\n' "$x.$y.$((z + 1))" ;;
    *)
      echo "harness: semver_bump: unknown level '$2' (want major|minor|patch)" >&2
      return 1
      ;;
  esac
}

# _manifest_normalize FILE -> prints one "tier path" per real entry.
# Ignores blank lines and `#` comments (leading whitespace tolerated).
# Fails (non-zero + stderr) on a malformed line: not exactly `tier path`, or an
# unknown tier.
_manifest_normalize() {
  local file="$1" line
  if [ ! -f "$file" ]; then
    echo "harness: manifest not found: $file" >&2
    return 2
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    # Word-split collapses surrounding whitespace; $1 is the first token.
    set -- $line
    [ "$#" -eq 0 ] && continue
    case "$1" in \#*) continue ;; esac
    if [ "$#" -ne 2 ]; then
      echo "harness: malformed manifest line (want '<tier> <path>'): $line" >&2
      return 2
    fi
    case "$1" in
      sync | region | ignore) ;;
      *)
        echo "harness: unknown tier '$1' in manifest line: $line" >&2
        return 2
        ;;
    esac
    printf '%s %s\n' "$1" "$2"
  done < "$file"
}

# manifest_tier FILE PATH -> prints sync|region|ignore for a listed path.
# Prints nothing and returns non-zero if the path is not listed.
manifest_tier() {
  local target="$2" normalized tier path found=""
  normalized=$(_manifest_normalize "$1") || return 2
  while read -r tier path; do
    [ "$path" = "$target" ] && found="$tier"
  done <<EOF
$normalized
EOF
  if [ -n "$found" ]; then
    printf '%s\n' "$found"
    return 0
  fi
  return 1
}

# manifest_paths FILE TIER -> prints the paths of that tier, one per line.
manifest_paths() {
  local want="$2" normalized tier path
  normalized=$(_manifest_normalize "$1") || return 2
  while read -r tier path; do
    [ "$tier" = "$want" ] && printf '%s\n' "$path"
  done <<EOF
$normalized
EOF
}

# --- dispatcher ------------------------------------------------------------

main() {
  local sub="$1"
  case "$sub" in
    '' | -h | --help | help)
      usage
      return 2
      ;;
    *)
      echo "harness: unknown command: $sub" >&2
      usage
      return 2
      ;;
  esac
}

usage() {
  cat >&2 <<'USAGE'
usage: harness <command> [args]

commands:
  release <major|minor|patch>   bump VERSION, roll CHANGELOG.md, commit, tag
USAGE
}

# Run main only when executed directly, not when sourced for tests.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  main "$@"
fi
